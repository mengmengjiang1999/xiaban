; Office Escape — one playable stealth level.
config_version=5

[application]
config/name="下班 · P2 人形动作样板"
config/name.p1="下班 · P1 移动与镜头"
config/name.p2="下班 · P2 人形动作样板"
run/main_scene="res://scenes/p2.tscn"
run/main_scene.p1="res://scenes/p1.tscn"
run/main_scene.p2="res://scenes/p2.tscn"
run/main_scene.p2_benchmark="res://tests/p2_performance.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/description="下班 P2：成人角色、六段骨骼动画与右肩镜头试玩。"
config/description.p1="下班 P1：办公室移动与右肩第三人称镜头试玩。"
config/version="0.3.0-p2"
config/version.p1="0.2.0-p1"
config/version.p2="0.3.0-p2"

[display]
window/size/viewport_width=1152
window/size/viewport_height=720
window/size/window_width_override=1152
window/size/window_height_override=720
window/stretch/mode="canvas_items"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.045, 0.07, 0.10, 1)
textures/default_filters/use_nearest_mipmap_filter=false
textures/vram_compression/import_etc2_astc=true
textures/vram_compression/import_s3tc_bptc=true
